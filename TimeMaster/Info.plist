<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Standard bundle keys (Xcode substitutes $(VAR) at build time) -->
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Tmax</string>
	<key>CFBundleDisplayName</key>
	<string>Tmax</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>

	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.timemaster.TimeMaster</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>timemaster</string>
			</array>
		</dict>
	</array>

	<!-- Privacy usage descriptions -->
	<key>NSCameraUsageDescription</key>
	<string>Tmax uses the camera for local exercise tracking and guided Physique stills. Exercise Ranked sends joint estimates, never images. Physique shares only selected face-obscured stills after separate consent.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Tmax needs photo library access to add photos of your exercises</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Tmax saves your Planned Trip map image to Photos so you can share it.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Tmax needs local network access to discover the companion server automatically</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Tmax records your active Run, Walk, or Bike route while you exercise.</string>
	<key>NSMotionUsageDescription</key>
	<string>Tmax uses the barometer to measure elevation gain during your outdoor workout.</string>
	<key>TMSupabaseURL</key>
	<string>$(TM_SUPABASE_URL)</string>
	<key>TMSupabaseAnonKey</key>
	<string>$(TM_SUPABASE_ANON_KEY)</string>
	<key>TMSyncServiceURL</key>
	<string>$(TM_SYNC_SERVICE_URL)</string>
	<key>TMRankedServiceURL</key>
	<string>$(TM_RANKED_SERVICE_URL)</string>
	<key>TMExploreStyleURL</key>
	<string>$(TM_EXPLORE_STYLE_URL)</string>
	<key>TMExploreOfflineAllowed</key>
	<string>$(TM_EXPLORE_OFFLINE_ALLOWED)</string>
	<key>TMMapTilerKey</key>
	<string>$(TM_MAPTILER_KEY)</string>
	<key>TMMapTilerTerrainStyleURL</key>
	<string>$(TM_MAPTILER_TERRAIN_STYLE_URL)</string>
	<key>TMMapTilerSatelliteStyleURL</key>
	<string>$(TM_MAPTILER_SATELLITE_STYLE_URL)</string>
	<key>TMMapTilerThreeDStyleURL</key>
	<string>$(TM_MAPTILER_3D_STYLE_URL)</string>
	<key>TMMapTilerCyclingStyleURL</key>
	<string>$(TM_MAPTILER_CYCLING_STYLE_URL)</string>
	<key>TMMapTilerDarkStyleURL</key>
	<string>$(TM_MAPTILER_DARK_STYLE_URL)</string>
	<key>TMMapTilerOfflineStyleURL</key>
	<string>$(TM_MAPTILER_OFFLINE_STYLE_URL)</string>
	<key>TMMapTilerOfflineLicensed</key>
	<string>$(TM_MAPTILER_OFFLINE_LICENSED)</string>
	<key>TMTerrainDEMURL</key>
	<string>$(TM_TERRAIN_DEM_URL)</string>
	<key>TMSatelliteRasterTileURL</key>
	<string>$(TM_SATELLITE_RASTER_TILE_URL)</string>
	<key>TMTomTomTrafficTileURL</key>
	<string>$(TM_TOMTOM_TRAFFIC_TILE_URL)</string>
	<key>TMTomTomTrafficKey</key>
	<string>$(TM_TOMTOM_TRAFFIC_KEY)</string>
	<key>TMTomTomTrafficSourceLayer</key>
	<string>$(TM_TOMTOM_TRAFFIC_SOURCE_LAYER)</string>
	<key>TMLicensedTransitFeedURL</key>
	<string>$(TM_LICENSED_TRANSIT_FEED_URL)</string>
	<key>TMLicensedTransitTileURL</key>
	<string>$(TM_LICENSED_TRANSIT_TILE_URL)</string>
	<key>TMLicensedTransitSourceLayer</key>
	<string>$(TM_LICENSED_TRANSIT_SOURCE_LAYER)</string>
	<key>TMLicensedTransitAttribution</key>
	<string>$(TM_LICENSED_TRANSIT_ATTRIBUTION)</string>

	<key>UIAppFonts</key>
	<array>
		<string>MapGlyphs/FontFiles/Inter Black.ttf</string>
		<string>MapGlyphs/FontFiles/Inter Light.ttf</string>
	</array>

	<!-- UI settings -->
	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleLightContent</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>TmaxLaunchBackground</string>
	</dict>

	<!-- Scene manifest -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict/>
	</dict>

	<!-- Background audio: allows music/TTS to continue when screen locks -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>location</string>
	</array>
</dict>
</plist>
