{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node", "react"]
  },
  "include": ["templates/**/*.tsx", "components/**/*.tsx", "theme.ts"],
  "exclude": ["node_modules", ".react-email", "out"]
}
